<Window x:Class="AutoLayer.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="500" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="12"
        Background="#141519"
        Foreground="#F1F5F9"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

  <!-- 配色与 UiTheme.cs 是同一套，改一处必须同步那边 -->
  <Window.Resources>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Background" Value="#2563EB"/>
      <Setter Property="BorderBrush" Value="#2563EB"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#3B82F6"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#60A5FA"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Foreground" Value="#C9D1DC"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="#33FFFFFF"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#4DFFFFFF"/>
                <Setter Property="Foreground" Value="#F1F5F9"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#0AFFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 输入框 ============ -->
    <Style x:Key="DarkBox" TargetType="TextBox">
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="9,0"/>
      <Setter Property="Foreground" Value="#F1F5F9"/>
      <Setter Property="Background" Value="#26282F"/>
      <Setter Property="BorderBrush" Value="#33FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CaretBrush" Value="#60A5FA"/>
      <Setter Property="SelectionBrush" Value="#2563EB"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#4DFFFFFF"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#60A5FA"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 分段选择（单选按钮排成一组） ============ -->
    <Style x:Key="SegRadio" TargetType="RadioButton">
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="13,0"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Foreground" Value="#98A0AC"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="#33FFFFFF"
                    BorderThickness="1" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#4DFFFFFF"/>
                <Setter Property="Foreground" Value="#F1F5F9"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#60A5FA"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ 滑杆 ============
         默认 WPF 滑杆是白底浅灰轨道，压在深色窗口上像贴纸。
         这里只留一条 4px 轨道 + 一个圆钮：轨道被"已选中"那半段填成蓝色，
         靠 DecreaseRepeatButton 自带的那块 Border 表现，不需要额外绑定。 -->
    <Style x:Key="DarkSlider" TargetType="Slider">
      <Setter Property="Height" Value="22"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid VerticalAlignment="Center">
              <Border Height="4" CornerRadius="2" Background="#2E313A"/>
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="#2563EB"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="13" Height="13">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="#FFFFFF" Stroke="#60A5FA" StrokeThickness="1.2"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>

  <StackPanel Margin="20,18,20,16">

    <!-- ================= 面板 ================= -->
    <TextBlock Text="面板" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9"/>

    <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="76"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <TextBlock Text="快捷键" Foreground="#6E7683" FontSize="11" VerticalAlignment="Center"/>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Border x:Name="KeyBox" Width="164" Height="30" CornerRadius="6"
                BorderThickness="1" BorderBrush="#33FFFFFF" Background="#26282F"
                Focusable="True" Cursor="Hand"
                MouseLeftButtonDown="KeyBox_MouseLeftButtonDown">
          <TextBlock x:Name="TxtKey" Text="Ctrl+Shift+Q" FontSize="11.5"
                     Foreground="#F1F5F9"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <Button Content="清除" Style="{StaticResource GhostButton}" Height="30"
                Padding="12,0" Margin="8,0,0,0" Click="BtnClearKey_Click"/>
      </StackPanel>
    </Grid>

    <TextBlock x:Name="TxtKeyHint" Margin="76,7,0,0" FontSize="10.5" Foreground="#6E7683"
               TextWrapping="Wrap" LineHeight="16"
               Text="点上面的框，然后按下想用的组合键。必须带 Ctrl / Alt 之一（只有 Shift 的组合会跟打字抢键）。"/>

    <!-- CAD 命令：AutoCAD 没法在运行期注册新命令名，这条是发一句 LISP 出去的 -->
    <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="76"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <TextBlock Text="CAD 命令" Foreground="#6E7683" FontSize="11" VerticalAlignment="Center"/>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <TextBox x:Name="TxtAlias" Style="{StaticResource DarkBox}"
                 Width="164" MaxLength="20"
                 TextChanged="TxtAlias_TextChanged"
                 ToolTip="填一个命令名，敲它就等于敲 QH。留空 = 不用。"/>

        <Button Content="清除" Style="{StaticResource GhostButton}" Height="30"
                Padding="12,0" Margin="8,0,0,0" Click="BtnClearAlias_Click"/>
      </StackPanel>
    </Grid>

    <TextBlock x:Name="TxtAliasHint" Margin="76,7,0,0" FontSize="10.5" Foreground="#6E7683"
               TextWrapping="Wrap" LineHeight="16"
               Text="自定义命令名，敲它等于敲 QH（比如填 GH）。留空 = 只用 QH。别用 L / C / M 这类单字母，会被 CAD 自己的别名盖住。"/>

    <!-- ================= 圆盘 ================= -->
    <Border Height="1" Background="#1FFFFFFF" Margin="0,16,0,14"/>

    <TextBlock Text="圆盘" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9"/>

    <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="76"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="触发方式" Foreground="#6E7683" FontSize="11" VerticalAlignment="Center"/>

      <!-- 四个选项挤在一行（1.12 去掉了「任一侧键」那一档） -->
      <WrapPanel Grid.Column="1">
        <RadioButton x:Name="RdoRight" Style="{StaticResource SegRadio}" Checked="Trig_Changed" Content="右键长按" GroupName="Trig" Padding="10,0"/>
        <RadioButton x:Name="RdoX1" Style="{StaticResource SegRadio}" Checked="Trig_Changed" Content="侧键后退" GroupName="Trig" Padding="10,0"/>
        <RadioButton x:Name="RdoX2" Style="{StaticResource SegRadio}" Checked="Trig_Changed" Content="侧键前进" GroupName="Trig" Padding="10,0"/>
        <RadioButton x:Name="RdoOff" Style="{StaticResource SegRadio}" Checked="Trig_Changed" Content="关闭" GroupName="Trig" Padding="10,0"
                     Margin="0"/>
      </WrapPanel>
    </Grid>

    <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="76"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="长按时长" Foreground="#6E7683" FontSize="11" VerticalAlignment="Center"/>

      <Slider x:Name="SldHold" Grid.Column="1" Style="{StaticResource DarkSlider}"
              Minimum="100" Maximum="1000" SmallChange="10" LargeChange="50"
              Value="180" ValueChanged="SldHold_ValueChanged"
              VerticalAlignment="Center"/>

      <TextBlock x:Name="TxtHold" Grid.Column="2" Width="56" FontSize="11"
                 Foreground="#C9D1DC" VerticalAlignment="Center" TextAlignment="Right"
                 Text="180 ms"/>
    </Grid>

    <TextBlock x:Name="TxtPieHint" Margin="76,7,0,0" FontSize="10.5" Foreground="#6E7683"
               TextWrapping="Wrap" LineHeight="16"
               Text="长按时长只对「右键长按」有效。按住不动到这个时间才弹，短按照旧是 CAD 的右键菜单。"/>

    <!-- ================= 底部 ================= -->
    <Border Height="1" Background="#1FFFFFFF" Margin="0,16,0,12"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="取消" IsCancel="True" Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
      <Button Content="保存" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="BtnSave_Click"/>
    </StackPanel>

  </StackPanel>
</Window>
