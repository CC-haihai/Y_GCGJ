<Window x:Class="AutoLayer.UI.QuickSwitch.LayerSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AutoLayer.UI.QuickSwitch"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="图层切换"
        Width="360" Height="480"
        MinWidth="320" MaxWidth="480"
        MinHeight="320" MaxHeight="720"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        AllowsTransparency="False"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="12"
        Background="{DynamicResource Yb.BgDeep}"
        Foreground="{DynamicResource Yb.Text}"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewTextInput="Window_PreviewTextInput">

    <!--
      视觉规格来源：merged/design/01-visual-spec.md v1.5 + 02-ux-spec.md v2.4
        §2 Token        —— Yb.* 画刷与 UiTheme.cs 同一套值，改一处两边同步
        §5.1 标题栏     —— 紧凑档 32：标题 13.5 + [打开主面板 26] → 12 净空 → [✕ 32]
        §5.8 内容流     —— 搜索 30 → chips 22 → 模式条 26 → 快捷行 26 → 列表 28/行 → 底部 44
        §6.8 chip / §6.10 列表行 / §6.11 复选方块 / §6.12 空状态 / §6.15 模式条 / §6.16 快捷行
      行为规格来源：02-ux-spec §3.2–§3.10（结构重做已拍板）。
    -->
    <Window.Resources>
        <local:HighlightBackgroundConverter x:Key="HighlightBackgroundConverter"/>
        <local:HighlightForegroundConverter x:Key="HighlightForegroundConverter"/>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>

        <!-- ======== §2.1 底色 ======== -->
        <SolidColorBrush x:Key="Yb.BgDeep" Color="#141519"/>
        <SolidColorBrush x:Key="Yb.Surface" Color="#202128"/>
        <SolidColorBrush x:Key="Yb.Raised" Color="#26282F"/>
        <SolidColorBrush x:Key="Yb.Sunken" Color="#1A1B20"/>

        <!-- ======== §2.2 线 ======== -->
        <SolidColorBrush x:Key="Yb.Line" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="Yb.LineStrong" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="Yb.LineControl" Color="#66FFFFFF"/>
        <SolidColorBrush x:Key="Yb.LineHover" Color="#80FFFFFF"/>

        <!-- ======== §2.3 文字 ======== -->
        <SolidColorBrush x:Key="Yb.Text" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="Yb.TextDim" Color="#98A0AC"/>
        <SolidColorBrush x:Key="Yb.TextFaint" Color="#8A93A0"/>
        <SolidColorBrush x:Key="Yb.SelectionText" Color="#FFFFFF"/>

        <!-- ======== §2.4 强调 ======== -->
        <SolidColorBrush x:Key="Yb.Accent" Color="#2563EB"/>
        <SolidColorBrush x:Key="Yb.AccentHi" Color="#3B82F6"/>
        <SolidColorBrush x:Key="Yb.AccentLine" Color="#60A5FA"/>
        <SolidColorBrush x:Key="Yb.AccentSoft" Color="#1E2A44"/>
        <SolidColorBrush x:Key="Yb.AccentInk" Color="#DBEAFE"/>
        <SolidColorBrush x:Key="Yb.AccentSoftBorder" Color="#4D60A5FA"/>
        <SolidColorBrush x:Key="Yb.TextOnAccent" Color="#FFFFFF"/>

        <!-- ======== §2.5 语义 ======== -->
        <SolidColorBrush x:Key="Yb.Ok" Color="#34D399"/>
        <SolidColorBrush x:Key="Yb.Warn" Color="#F59E0B"/>
        <SolidColorBrush x:Key="Yb.WarnSoft" Color="#2F2517"/>
        <SolidColorBrush x:Key="Yb.WarnLine" Color="#4C3716"/>
        <SolidColorBrush x:Key="Yb.Danger" Color="#F87171"/>
        <SolidColorBrush x:Key="Yb.DangerSoft" Color="#2A1A1C"/>
        <SolidColorBrush x:Key="Yb.DangerLine" Color="#4D3A3C"/>

        <!-- ======== §2.6 状态叠加 / 空状态线稿 ======== -->
        <SolidColorBrush x:Key="Yb.Hover" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="Yb.HoverRow" Color="#0FFFFFFF"/>
        <SolidColorBrush x:Key="Yb.Pressed" Color="#0AFFFFFF"/>
        <SolidColorBrush x:Key="Yb.SelectionBg" Color="#1E2A44"/>
        <SolidColorBrush x:Key="Yb.SelectionMark" Color="#60A5FA"/>
        <SolidColorBrush x:Key="Yb.EmptyArt" Color="#2E313A"/>
        <SolidColorBrush x:Key="Yb.EmptyArtFill" Color="#1A1B20"/>

        <!-- chip 三态：代码在 UpdateCategorySelection 里按这三个 key 取刷子 -->
        <SolidColorBrush x:Key="Yb.ChipBg" Color="#26282F"/>
        <SolidColorBrush x:Key="Yb.ChipFg" Color="#98A0AC"/>
        <SolidColorBrush x:Key="Yb.ChipSelBg" Color="#1E2A44"/>
        <SolidColorBrush x:Key="Yb.ChipSelFg" Color="#DBEAFE"/>
        <SolidColorBrush x:Key="Yb.ChipSelBorder" Color="#60A5FA"/>

        <!-- 注意：不使用自定义 ScrollViewer/ScrollBar 模板。
             在 AutoCAD Win32 宿主中嵌入的 WPF 窗口，自定义滚动条模板会在
             布局/渲染管线中抛出无法被 try-catch 捕获的异常，导致宿主崩溃。
             使用默认 ScrollViewer + 默认 ScrollBar 保证稳定性（§6.13 宿主约束）。 -->

        <!-- ======== §6.3 图标按钮：标题栏 26×26 ======== -->
        <Style x:Key="TitleIconButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Yb.TextDim}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Yb.Hover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Yb.Text}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Yb.Pressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======== §5.1 关闭按钮：32×32（= 栏高），贴右缘 ======== -->
        <Style x:Key="CloseBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Yb.TextDim}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <Path Data="M2 2 L10 10 M10 2 L2 10"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="12" Height="12" Stretch="None"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Yb.Hover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Yb.Text}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Yb.Pressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======== §6.8 分类 chip：高 22 / 圆角 4 ======== -->
        <!-- 选中态由代码设 Background / Foreground / BorderBrush，模板只负责 hover 叠加层 -->
        <Style x:Key="CategoryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Yb.ChipBg}"/>
            <Setter Property="Foreground" Value="{StaticResource Yb.ChipFg}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="0,0,4,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"/>
                            <Border x:Name="HoverLayer" Background="{StaticResource Yb.Hover}"
                                    CornerRadius="4" Visibility="Collapsed" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverLayer" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Yb.Pressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======== §6.16 最近快捷行 chip：常态底 Sunken（压在 BgDeep 上不抢注意力） ======== -->
        <Style x:Key="RecentChipStyle" TargetType="Button" BasedOn="{StaticResource CategoryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource Yb.Sunken}"/>
            <Setter Property="Foreground" Value="{StaticResource Yb.TextDim}"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <!-- ======== 底部按钮（§5.8）：次按钮 32 / 主按钮 32 ======== -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="{StaticResource Yb.Raised}"/>
            <Setter Property="Foreground" Value="{StaticResource Yb.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Yb.LineControl}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Yb.LineHover}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Yb.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Yb.Pressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="{StaticResource Yb.Accent}"/>
            <Setter Property="Foreground" Value="{StaticResource Yb.TextOnAccent}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Yb.AccentHi}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Yb.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======== §6.10 列表行 ======== -->
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Yb.HoverRow}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Yb.SelectionBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======== §6.11 复选方块 14×14 r4 ======== -->
        <Style x:Key="CheckSquare" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Yb.Text}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="14" Height="14" CornerRadius="4"
                                    Background="{StaticResource Yb.Raised}"
                                    BorderBrush="{StaticResource Yb.LineControl}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Tick" Data="M3 7.2 L5.6 9.8 L11 4.2"
                                      Stroke="{StaticResource Yb.Text}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed" Stretch="None"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Yb.Accent}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Yb.Accent}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Yb.LineHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======== §6.15 模式条「改选 ▸」：纯文字按钮，hover 只换字色不加底 ======== -->
        <Style x:Key="ReselectBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Yb.AccentLine}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="9,0,9,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 点击区撑满模式条高 26（§6.15），右内边距 9。文案走 Content（代码里按状态写） -->
                        <Border Background="Transparent">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Margin="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                                <Path Data="M1 1 L5 4 L1 7" Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="6" Height="8" Stretch="None" Margin="6,0,0,0"
                                      VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Yb.Text}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Yb.Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 根布局：紧凑标题栏 32 + 内容区 -->
    <Grid x:Name="RootGrid" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 标题栏 32 -->
            <RowDefinition Height="*"/>      <!-- 内容区 -->
        </Grid.RowDefinitions>

        <!-- ====== §5.1 紧凑标题栏 ====== -->
        <Border Grid.Row="0" Height="32" Background="{StaticResource Yb.Surface}"
                BorderBrush="{StaticResource Yb.Line}" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="图层切换" VerticalAlignment="Center" Margin="18,0,0,0"
                           Foreground="{StaticResource Yb.Text}" FontSize="13.5" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- 打开主面板：V1.0 的 ⚙ 保留，语义收窄为"回主面板"，图标换成窗口+右箭头 -->
                    <Button x:Name="BtnOpenPanel" Style="{StaticResource TitleIconButton}"
                            Margin="0,0,12,0" Click="OpenAutoLayer_Click"
                            ToolTip="打开主面板（QH）"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid Width="14" Height="14">
                            <Path Data="M1.2 2.4 H7.4 V11.6 H1.2 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="1.4" StrokeLineJoin="Round" Stretch="None"/>
                            <Path Data="M9.2 7 H12.8 M10.9 4.9 L13 7 L10.9 9.1"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Stretch="None"/>
                        </Grid>
                    </Button>
                    <Button x:Name="BtnClose" Click="CloseBtn_Click" Style="{StaticResource CloseBtnStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ====== §5.8 / §7.4 内容流 ====== -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 搜索 30 -->
                <RowDefinition Height="Auto"/>   <!-- chips 22（可能折叠成 2 行） -->
                <RowDefinition Height="Auto"/>   <!-- 模式条 26 -->
                <RowDefinition Height="Auto"/>   <!-- 最近快捷行 26（v1.9g 横排自适应） -->
                <RowDefinition Height="*"/>      <!-- 列表 28/行 + 空状态 -->
                <RowDefinition Height="Auto"/>   <!-- 底部 44 -->
            </Grid.RowDefinitions>

            <!-- 搜索框：30 / r6 / Raised / LineControl / 内边距 9 -->
            <Border Grid.Row="0" Height="30" Margin="18,14,18,0"
                    Background="{StaticResource Yb.Raised}"
                    BorderBrush="{StaticResource Yb.LineControl}" BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource Yb.Text}" CaretBrush="{StaticResource Yb.AccentLine}"
                             FontSize="11.5" Padding="9,0,28,0" VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"
                             GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus"/>
                    <TextBlock x:Name="SearchPlaceholder" Text="搜索图层" VerticalAlignment="Center"
                               Margin="10,0,0,0" FontSize="11.5"
                               Foreground="{StaticResource Yb.TextDim}" IsHitTestVisible="False"/>
                    <Button x:Name="ClearSearchBtn" Width="24" Height="24"
                            HorizontalAlignment="Right" Margin="0,0,4,0" Background="Transparent"
                            BorderThickness="0" Foreground="{StaticResource Yb.TextDim}"
                            Visibility="Collapsed" Cursor="Hand" Click="ClearSearchBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" CornerRadius="4">
                                    <Path Data="M2.5 2.5 L9.5 9.5 M9.5 2.5 L2.5 9.5"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="12" Height="12" Stretch="None"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- 分类 chips：容器 Sunken / 内边距 6；chip 区永不滚动，超 2 行折叠 +N（§3.5.3） -->
            <Border x:Name="CategoryBar" Grid.Row="1" Background="{StaticResource Yb.Sunken}"
                    Padding="6" Margin="18,6,18,0" SizeChanged="CategoryBar_SizeChanged">
                <WrapPanel x:Name="CategoryPanel" Orientation="Horizontal"/>
            </Border>

            <!-- ====== §6.15 任务模式条：高 26 / 圆角 4 / 四态由代码切换 ====== -->
            <!-- 本体不可点、不占 Tab。纯当前层模式（无告警）整条隐藏（v1.9c 拍板：常驻占一整行不值），
                 但有「回到上次选中」时占条 —— 按钮回到模式条右侧原位（v1.9d 用户拍板：左下角不顺手）。
                 对象模式 / 警告 / 错误反馈时出现 -->
            <Border x:Name="ModeBar" Grid.Row="2" Height="26" Margin="18,6,18,0"
                    CornerRadius="4" Background="{StaticResource Yb.Sunken}"
                    BorderBrush="{StaticResource Yb.Line}" BorderThickness="1">
                <Grid Margin="9,0,6,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="ModeIcon" Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center">
                            <!-- 箭头（对象模式） -->
                            <Path x:Name="IconArrow" Data="M1 6 H9 M6.4 2.6 L9.6 6 L6.4 9.4"
                                  Stroke="{StaticResource Yb.AccentLine}" StrokeThickness="1.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                            <!-- 图层（当前层模式） -->
                            <Path x:Name="IconLayer" Data="M1.5 3.4 L6 1.4 L10.5 3.4 L6 5.4 Z M1.5 3.4 V8.6 L6 10.6 L10.5 8.6 V3.4 M6 5.4 V10.6"
                                  Stroke="{StaticResource Yb.TextDim}" StrokeThickness="1.2"
                                  StrokeLineJoin="Round" Visibility="Collapsed"/>
                            <!-- 三角（警告） -->
                            <Path x:Name="IconWarn" Data="M6 1.6 L11 10.4 H1 Z"
                                  Stroke="{StaticResource Yb.Warn}" StrokeThickness="1.2"
                                  StrokeLineJoin="Round" Visibility="Collapsed"/>
                            <!-- 叉（错误） -->
                            <Path x:Name="IconError" Data="M2 2 L10 10 M10 2 L2 10"
                                  Stroke="{StaticResource Yb.Danger}" StrokeThickness="1.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                        </Grid>
                    <TextBlock x:Name="ModeText" Grid.Column="1" Text="" Margin="6,0,0,0" VerticalAlignment="Center"
                               FontSize="11.5" Foreground="{StaticResource Yb.TextDim}"
                               TextTrimming="CharacterEllipsis"/>
                    <!-- 「回到上次选中 ▸」：模式条右侧原位（v1.9d）。空手打开（当前层模式）/ 图元失效时出现；
                         对象模式不出现。点击区撑满条高 26（§6.15） -->
                    <Button x:Name="BtnReselect" Grid.Column="2" Style="{StaticResource ReselectBtn}"
                            VerticalAlignment="Stretch" HorizontalAlignment="Right"
                            Click="Reselect_Click" Visibility="Collapsed"
                            ToolTip="把这批图元重新装回本次操作（Alt+R）"/>
                </Grid>
            </Border>

            <!-- ====== §6.16 最近快捷行：高 26 / 透明底 / ≤5 chip / 条件出现 ====== -->
            <!-- v1.9g：回到横排（用户拍板竖排不好看），按面板宽度自适应显示几个，
                 放不下的直接不显示（无 +N）。可用宽度不取 chip 区自身的 ActualWidth ——
                 实测横向 StackPanel 会被排成自然宽（v1.9e 实机溢出的根因），
                 改用 RecentRow 宽 - 「最近」标签宽，确定可靠。
                 ClipToBounds 兜底：就算折叠没跑，也只在行内裁剪，绝不画出面板右缘 -->
            <Border x:Name="RecentRow" Grid.Row="3" Height="26" Margin="18,4,18,0"
                    Background="Transparent" Visibility="Collapsed" ClipToBounds="True"
                    PreviewKeyDown="RecentPanel_PreviewKeyDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RecentLabel" Grid.Column="0" Text="最近" FontSize="10.5"
                               Foreground="{StaticResource Yb.TextDim}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <StackPanel x:Name="RecentPanel" Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" ClipToBounds="True"
                                LayoutUpdated="RecentPanel_LayoutUpdated"
                                SizeChanged="RecentPanel_SizeChanged"/>
                </Grid>
            </Border>

            <!-- 图层列表：底 Sunken，上下各 1px Line；列表区与空状态互斥（§6.12 只替换列表区） -->
            <Border Grid.Row="4" Background="{StaticResource Yb.Sunken}"
                    BorderBrush="{StaticResource Yb.Line}" BorderThickness="0,1,0,1"
                    Margin="18,6,18,0">
                <Grid>
                    <ListBox x:Name="LayerListBox" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource Yb.Text}" FontSize="12"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             SelectionChanged="LayerListBox_SelectionChanged"
                             MouseDoubleClick="LayerListBox_MouseDoubleClick"
                             PreviewKeyDown="LayerListBox_PreviewKeyDown"
                             ScrollViewer.CanContentScroll="True"
                             KeyboardNavigation.TabNavigation="Once">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="RowRoot" Height="28">
                                    <!-- 选中/高亮 2px 左缘竖条（三重编码之一） -->
                                    <Rectangle x:Name="Mark" Width="2" HorizontalAlignment="Left"
                                               Fill="{StaticResource Yb.SelectionMark}" Visibility="Collapsed"/>
                                    <Border BorderBrush="{StaticResource Yb.Line}" BorderThickness="0,0,0,1"/>
                                    <Grid Margin="12,0,12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="72"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- 色块三件套：内衬 EmptyArtFill → 图层色 → 1px #4DFFFFFF 描边 -->
                                        <Border Grid.Column="0" Width="12" Height="12"
                                                CornerRadius="2" VerticalAlignment="Center"
                                                Background="{StaticResource Yb.EmptyArtFill}"
                                                BorderBrush="#4DFFFFFF" BorderThickness="1">
                                            <Border Background="{Binding ColorBrush}" CornerRadius="1"
                                                    Margin="1" Width="8" Height="8"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="NameText" Grid.Column="1" Text="{Binding Name}"
                                                   Margin="8,0,8,0" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" FontSize="12"
                                                   Foreground="{Binding IsHighlighted, Converter={StaticResource HighlightForegroundConverter}}"/>
                                        <TextBlock x:Name="StatusText" Grid.Column="2" Text="{Binding StatusText}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                                   FontSize="10.5" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource Yb.TextDim}"/>
                                    </Grid>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <!-- 图纸里正在高亮的图层：与选中同语义（§7.1） -->
                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                        <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource Yb.SelectionText}"/>
                                    </DataTrigger>
                                    <!-- 键盘/鼠标选中 -->
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                        <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource Yb.SelectionText}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- ====== §6.12 空状态：只替换列表区，搜索/chip/模式条/快捷行/底部全部留在原位 ====== -->
                    <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                                VerticalAlignment="Center" Margin="0,-8,0,0" MaxWidth="260">
                        <!-- 中性线稿 24 画布 -->
                        <Path x:Name="EmptyIcon" Data="M4 9.5 V3.5 L12 1.5 V7.5 M4 9.5 L12 7.5 M12 7.5 L20 9.5 M4 9.5 L12 11.5 M12 11.5 L20 9.5 M12 11.5 V17.5 M4 9.5 L12 11.5"
                              Stroke="{StaticResource Yb.EmptyArt}" StrokeThickness="1.4"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="24" Height="24" Stretch="None" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyTitle" Text="" FontSize="12"
                                   Foreground="{StaticResource Yb.TextDim}" HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>
                        <TextBlock x:Name="EmptyDesc" Text="" FontSize="11.5"
                                   Foreground="{StaticResource Yb.TextFaint}" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <!-- 出路按钮：一律 32 高次按钮，并排为默认（窄放不下才竖排，代码判断） -->
                        <StackPanel x:Name="EmptyButtons" Orientation="Horizontal"
                                    HorizontalAlignment="Center" Margin="0,14,0,14"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ====== 底部 44：左侧上下文（对象模式=勾选框 / 当前层模式且无回归按钮时=左下角提示）+ 右 [取消] [主按钮] ====== -->
            <Grid Grid.Row="5" Height="44" Margin="18,6,18,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <CheckBox x:Name="SetCurrentCheckBox" Style="{StaticResource CheckSquare}"
                              Content="同时设为当前图层" VerticalAlignment="Center" IsChecked="False"/>
                    <!-- 当前层模式左下角提示（v1.9c：从模式条挪来，不再常驻占一整行；
                         v1.9d：有回归按钮时让位 —— 模式条左侧文字已说明当前模式） -->
                    <TextBlock x:Name="BottomHint" Text="仅切换当前图层" VerticalAlignment="Center"
                               FontSize="10.5" Foreground="{StaticResource Yb.TextFaint}" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnCancel" Style="{StaticResource SecondaryBtn}" Content="取消"
                            Margin="0,0,8,0" Click="CancelBtn_Click"/>
                    <Button x:Name="BtnApply" Style="{StaticResource PrimaryBtn}" Content="移到该层"
                            Click="ApplyBtn_Click" MouseEnter="ApplyBtn_MouseEnter" MouseLeave="ApplyBtn_MouseLeave"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
